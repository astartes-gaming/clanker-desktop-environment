<!--
     Character entity set. Typical invocation:
     <!ENTITY % isolat1 PUBLIC
       "ISO 8879-1986//ENTITIES Added Latin 1//EN">
     %isolat1;
-->

<!ENTITY Aacute   SDATA "[Aacute]" ><!--LATIN CAPITAL LETTER A WITH ACUTE -->
<!ENTITY aacute   SDATA "[aacute]" ><!--LATIN SMALL LETTER A WITH ACUTE -->
<!ENTITY Acirc    SDATA "[Acirc ]" ><!--LATIN CAPITAL LETTER A WITH CIRCUMFLEX -->
<!ENTITY acirc    SDATA "[acirc ]" ><!--LATIN SMALL LETTER A WITH CIRCUMFLEX -->
<!ENTITY AElig    SDATA "[AElig ]" ><!--LATIN CAPITAL LETTER AE -->
<!ENTITY aelig    SDATA "[aelig ]" ><!--LATIN SMALL LETTER AE -->
<!ENTITY Agrave   SDATA "[Agrave]" ><!--LATIN CAPITAL LETTER A WITH GRAVE -->
<!ENTITY agrave   SDATA "[agrave]" ><!--LATIN SMALL LETTER A WITH GRAVE -->
<!ENTITY Aring    SDATA "[Aring ]" ><!--LATIN CAPITAL LETTER A WITH RING ABOVE -->
<!ENTITY aring    SDATA "[aring ]" ><!--LATIN SMALL LETTER A WITH RING ABOVE -->
<!ENTITY Atilde   SDATA "[Atilde]" ><!--LATIN CAPITAL LETTER A WITH TILDE -->
<!ENTITY atilde   SDATA "[atilde]" ><!--LATIN SMALL LETTER A WITH TILDE -->
<!ENTITY Auml     SDATA "[Auml  ]" ><!--LATIN CAPITAL LETTER A WITH DIAERESIS -->
<!ENTITY auml     SDATA "[auml  ]" ><!--LATIN SMALL LETTER A WITH DIAERESIS -->
<!ENTITY Ccedil   SDATA "[Ccedil]" ><!--LATIN CAPITAL LETTER C WITH CEDILLA -->
<!ENTITY ccedil   SDATA "[ccedil]" ><!--LATIN SMALL LETTER C WITH CEDILLA -->
<!ENTITY Eacute   SDATA "[Eacute]" ><!--LATIN CAPITAL LETTER E WITH ACUTE -->
<!ENTITY eacute   SDATA "[eacute]" ><!--LATIN SMALL LETTER E WITH ACUTE -->
<!ENTITY Ecirc    SDATA "[Ecirc ]" ><!--LATIN CAPITAL LETTER E WITH CIRCUMFLEX -->
<!ENTITY ecirc    SDATA "[ecirc ]" ><!--LATIN SMALL LETTER E WITH CIRCUMFLEX -->
<!ENTITY Egrave   SDATA "[Egrave]" ><!--LATIN CAPITAL LETTER E WITH GRAVE -->
<!ENTITY egrave   SDATA "[egrave]" ><!--LATIN SMALL LETTER E WITH GRAVE -->
<!ENTITY ETH      SDATA "[ETH   ]" ><!--LATIN CAPITAL LETTER ETH -->
<!ENTITY eth      SDATA "[eth   ]" ><!--LATIN SMALL LETTER ETH -->
<!ENTITY Euml     SDATA "[Euml  ]" ><!--LATIN CAPITAL LETTER E WITH DIAERESIS -->
<!ENTITY euml     SDATA "[euml  ]" ><!--LATIN SMALL LETTER E WITH DIAERESIS -->
<!ENTITY Iacute   SDATA "[Iacute]" ><!--LATIN CAPITAL LETTER I WITH ACUTE -->
<!ENTITY iacute   SDATA "[iacute]" ><!--LATIN SMALL LETTER I WITH ACUTE -->
<!ENTITY Icirc    SDATA "[Icirc ]" ><!--LATIN CAPITAL LETTER I WITH CIRCUMFLEX -->
<!ENTITY icirc    SDATA "[icirc ]" ><!--LATIN SMALL LETTER I WITH CIRCUMFLEX -->
<!ENTITY Igrave   SDATA "[Igrave]" ><!--LATIN CAPITAL LETTER I WITH GRAVE -->
<!ENTITY igrave   SDATA "[igrave]" ><!--LATIN SMALL LETTER I WITH GRAVE -->
<!ENTITY Iuml     SDATA "[Iuml  ]" ><!--LATIN CAPITAL LETTER I WITH DIAERESIS -->
<!ENTITY iuml     SDATA "[iuml  ]" ><!--LATIN SMALL LETTER I WITH DIAERESIS -->
<!ENTITY Ntilde   SDATA "[Ntilde]" ><!--LATIN CAPITAL LETTER N WITH TILDE -->
<!ENTITY ntilde   SDATA "[ntilde]" ><!--LATIN SMALL LETTER N WITH TILDE -->
<!ENTITY Oacute   SDATA "[Oacute]" ><!--LATIN CAPITAL LETTER O WITH ACUTE -->
<!ENTITY oacute   SDATA "[oacute]" ><!--LATIN SMALL LETTER O WITH ACUTE -->
<!ENTITY Ocirc    SDATA "[Ocirc ]" ><!--LATIN CAPITAL LETTER O WITH CIRCUMFLEX -->
<!ENTITY ocirc    SDATA "[ocirc ]" ><!--LATIN SMALL LETTER O WITH CIRCUMFLEX -->
<!ENTITY Ograve   SDATA "[Ograve]" ><!--LATIN CAPITAL LETTER O WITH GRAVE -->
<!ENTITY ograve   SDATA "[ograve]" ><!--LATIN SMALL LETTER O WITH GRAVE -->
<!ENTITY Oslash   SDATA "[Oslash]" ><!--LATIN CAPITAL LETTER O WITH STROKE -->
<!ENTITY oslash   SDATA "[oslash]" ><!--LATIN SMALL LETTER O WITH STROKE -->
<!ENTITY Otilde   SDATA "[Otilde]" ><!--LATIN CAPITAL LETTER O WITH TILDE -->
<!ENTITY otilde   SDATA "[otilde]" ><!--LATIN SMALL LETTER O WITH TILDE -->
<!ENTITY Ouml     SDATA "[Ouml  ]" ><!--LATIN CAPITAL LETTER O WITH DIAERESIS -->
<!ENTITY ouml     SDATA "[ouml  ]" ><!--LATIN SMALL LETTER O WITH DIAERESIS -->
<!ENTITY szlig    SDATA "[szlig ]" ><!--LATIN SMALL LETTER SHARP S -->
<!ENTITY THORN    SDATA "[THORN ]" ><!--LATIN CAPITAL LETTER THORN -->
<!ENTITY thorn    SDATA "[thorn ]" ><!--LATIN SMALL LETTER THORN -->
<!ENTITY Uacute   SDATA "[Uacute]" ><!--LATIN CAPITAL LETTER U WITH ACUTE -->
<!ENTITY uacute   SDATA "[uacute]" ><!--LATIN SMALL LETTER U WITH ACUTE -->
<!ENTITY Ucirc    SDATA "[Ucirc ]" ><!--LATIN CAPITAL LETTER U WITH CIRCUMFLEX -->
<!ENTITY ucirc    SDATA "[ucirc ]" ><!--LATIN SMALL LETTER U WITH CIRCUMFLEX -->
<!ENTITY Ugrave   SDATA "[Ugrave]" ><!--LATIN CAPITAL LETTER U WITH GRAVE -->
<!ENTITY ugrave   SDATA "[ugrave]" ><!--LATIN SMALL LETTER U WITH GRAVE -->
<!ENTITY Uuml     SDATA "[Uuml  ]" ><!--LATIN CAPITAL LETTER U WITH DIAERESIS -->
<!ENTITY uuml     SDATA "[uuml  ]" ><!--LATIN SMALL LETTER U WITH DIAERESIS -->
<!ENTITY Yacute   SDATA "[Yacute]" ><!--LATIN CAPITAL LETTER Y WITH ACUTE -->
<!ENTITY yacute   SDATA "[yacute]" ><!--LATIN SMALL LETTER Y WITH ACUTE -->
<!ENTITY yuml     SDATA "[yuml  ]" ><!--LATIN SMALL LETTER Y WITH DIAERESIS -->
