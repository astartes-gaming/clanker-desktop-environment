<!--
     Character entity set. Typical invocation:
     <!ENTITY % isonum PUBLIC
       "ISO 8879-1986//ENTITIES Added Latin 1//EN">
     %isonum;
-->

<!ENTITY amp      CDATA "&#38;&#38;" ><!--AMPERSAND -->
<!ENTITY apos     SDATA "[apos  ]" ><!--APOSTROPHE -->
<!ENTITY ast      SDATA "[ast   ]" ><!--ASTERISK -->
<!ENTITY brvbar   SDATA "[brvbar]" ><!--BROKEN BAR -->
<!ENTITY bsol     SDATA "[bsol  ]" ><!--REVERSE SOLIDUS -->
<!ENTITY cent     SDATA "[cent  ]" ><!--CENT SIGN -->
<!ENTITY colon    SDATA "[colon ]" ><!--COLON -->
<!ENTITY comma    SDATA "[comma ]" ><!--COMMA -->
<!ENTITY commat   SDATA "[commat]" ><!--COMMERCIAL AT -->
<!ENTITY copy     SDATA "[copy  ]" ><!--COPYRIGHT SIGN -->
<!ENTITY curren   SDATA "[curren]" ><!--CURRENCY SIGN -->
<!ENTITY darr     SDATA "[darr  ]" ><!--DOWNWARDS ARROW -->
<!ENTITY deg      SDATA "[deg   ]" ><!--DEGREE SIGN -->
<!ENTITY divide   SDATA "[divide]" ><!--DIVISION SIGN -->
<!ENTITY dollar   SDATA "[dollar]" ><!--DOLLAR SIGN -->
<!ENTITY equals   SDATA "[equals]" ><!--EQUALS SIGN -->
<!ENTITY excl     SDATA "[excl  ]" ><!--EXCLAMATION MARK -->
<!ENTITY frac12   SDATA "[frac12]" ><!--VULGAR FRACTION ONE HALF -->
<!ENTITY frac14   SDATA "[frac14]" ><!--VULGAR FRACTION ONE QUARTER -->
<!ENTITY frac18   SDATA "[frac18]" ><!--VULGAR FRACTION ONE EIGHTH -->
<!ENTITY frac34   SDATA "[frac34]" ><!--VULGAR FRACTION THREE QUARTERS -->
<!ENTITY frac38   SDATA "[frac38]" ><!--VULGAR FRACTION THREE EIGHTHS -->
<!ENTITY frac58   SDATA "[frac58]" ><!--VULGAR FRACTION FIVE EIGHTHS -->
<!ENTITY frac78   SDATA "[frac78]" ><!--VULGAR FRACTION SEVEN EIGHTHS -->
<!ENTITY gt       SDATA "[gt    ]" ><!--GREATER-THAN SIGN -->
<!ENTITY half     SDATA "[half  ]" ><!--VULGAR FRACTION ONE HALF -->
<!ENTITY horbar   SDATA "[horbar]" ><!--HORIZONTAL BAR -->
<!ENTITY hyphen   SDATA "[hyphen]" ><!--HYPHEN -->
<!ENTITY iexcl    SDATA "[iexcl ]" ><!--INVERTED EXCLAMATION MARK -->
<!ENTITY iquest   SDATA "[iquest]" ><!--INVERTED QUESTION MARK -->
<!ENTITY laquo    SDATA "[laquo ]" ><!--LEFT-POINTING DOUBLE ANGLE QUOTATION MARK -->
<!ENTITY larr     SDATA "[larr  ]" ><!--LEFTWARDS ARROW -->
<!ENTITY lcub     SDATA "[lcub  ]" ><!--LEFT CURLY BRACKET -->
<!ENTITY ldquo    SDATA "[ldquo ]" ><!--LEFT DOUBLE QUOTATION MARK -->
<!ENTITY lowbar   SDATA "[lowbar]" ><!--LOW LINE -->
<!ENTITY lpar     SDATA "[lpar  ]" ><!--LEFT PARENTHESIS -->
<!ENTITY lsqb     SDATA "[lsqb  ]" ><!--LEFT SQUARE BRACKET -->
<!ENTITY lsquo    SDATA "[lsquo ]" ><!--LEFT SINGLE QUOTATION MARK -->
<!ENTITY lt       CDATA "&#38;&#60;" ><!--LESS-THAN SIGN -->
<!ENTITY micro    SDATA "[micro ]" ><!--MICRO SIGN -->
<!ENTITY middot   SDATA "[middot]" ><!--MIDDLE DOT -->
<!ENTITY nbsp     SDATA "[nbsp  ]" ><!--NO-BREAK SPACE -->
<!ENTITY not      SDATA "[not   ]" ><!--NOT SIGN -->
<!ENTITY num      SDATA "[num   ]" ><!--NUMBER SIGN -->
<!ENTITY ohm      SDATA "[ohm   ]" ><!--OHM SIGN -->
<!ENTITY ordf     SDATA "[ordf  ]" ><!--FEMININE ORDINAL INDICATOR -->
<!ENTITY ordm     SDATA "[ordm  ]" ><!--MASCULINE ORDINAL INDICATOR -->
<!ENTITY para     SDATA "[para  ]" ><!--PILCROW SIGN -->
<!ENTITY percnt   SDATA "[percnt]" ><!--PERCENT SIGN -->
<!ENTITY period   SDATA "[period]" ><!--FULL STOP -->
<!ENTITY plus     SDATA "[plus  ]" ><!--PLUS SIGN -->
<!ENTITY plusmn   SDATA "[plusmn]" ><!--PLUS-MINUS SIGN -->
<!ENTITY pound    SDATA "[pound ]" ><!--POUND SIGN -->
<!ENTITY quest    SDATA "[quest ]" ><!--QUESTION MARK -->
<!ENTITY quot     SDATA "[quot  ]" ><!--QUOTATION MARK -->
<!ENTITY raquo    SDATA "[raquo ]" ><!--RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK -->
<!ENTITY rarr     SDATA "[rarr  ]" ><!--RIGHTWARDS ARROW -->
<!ENTITY rcub     SDATA "[rcub  ]" ><!--RIGHT CURLY BRACKET -->
<!ENTITY rdquo    SDATA "[rdquo ]" ><!--RIGHT DOUBLE QUOTATION MARK -->
<!ENTITY reg      SDATA "[reg   ]" ><!--REGISTERED SIGN -->
<!ENTITY rpar     SDATA "[rpar  ]" ><!--RIGHT PARENTHESIS -->
<!ENTITY rsqb     SDATA "[rsqb  ]" ><!--RIGHT SQUARE BRACKET -->
<!ENTITY rsquo    SDATA "[rsquo ]" ><!--RIGHT SINGLE QUOTATION MARK -->
<!ENTITY sect     SDATA "[sect  ]" ><!--SECTION SIGN -->
<!ENTITY semi     SDATA "[semi  ]" ><!--SEMICOLON -->
<!ENTITY shy      SDATA "[shy   ]" ><!--SOFT HYPHEN -->
<!ENTITY sol      SDATA "[sol   ]" ><!--SOLIDUS -->
<!ENTITY sung     CDATA "&#9834;" ><!--EIGHTH NOTE -->
<!ENTITY sup1     SDATA "[sup1  ]" ><!--SUPERSCRIPT ONE -->
<!ENTITY sup2     SDATA "[sup2  ]" ><!--SUPERSCRIPT TWO -->
<!ENTITY sup3     SDATA "[sup3  ]" ><!--SUPERSCRIPT THREE -->
<!ENTITY times    SDATA "[times ]" ><!--MULTIPLICATION SIGN -->
<!ENTITY trade    SDATA "[trade ]" ><!--TRADE MARK SIGN -->
<!ENTITY uarr     SDATA "[uarr  ]" ><!--UPWARDS ARROW -->
<!ENTITY verbar   SDATA "[verbar]" ><!--VERTICAL LINE -->
<!ENTITY yen      SDATA "[yen   ]" ><!--YEN SIGN -->
