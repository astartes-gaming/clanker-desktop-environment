<!--
     Character entity set. Typical invocation:
     <!ENTITY % isotech PUBLIC
       "ISO 8879-1986//ENTITIES Added Latin 1//EN">
     %isotech;
-->

<!ENTITY aleph    SDATA "[aleph ]" ><!--ALEF SYMBOL -->
<!ENTITY and      SDATA "[and   ]" ><!--LOGICAL AND -->
<!ENTITY ang90    CDATA "&#8735;" ><!--RIGHT ANGLE -->
<!ENTITY angsph   CDATA "&#8738;" ><!--SPHERICAL ANGLE -->
<!ENTITY angst    SDATA "[angst ]" ><!--ANGSTROM SIGN -->
<!ENTITY ap       SDATA "[ap    ]" ><!--ALMOST EQUAL TO -->
<!ENTITY becaus   CDATA "&#8757;" ><!--BECAUSE -->
<!ENTITY bernou   CDATA "&#8492;" ><!--SCRIPT CAPITAL B -->
<!ENTITY bottom   SDATA "[bottom]" ><!--UP TACK -->
<!ENTITY cap      SDATA "[cap   ]" ><!--INTERSECTION -->
<!ENTITY compfn   CDATA "&#8728;" ><!--RING OPERATOR -->
<!ENTITY cong     SDATA "[cong  ]" ><!--APPROXIMATELY EQUAL TO -->
<!ENTITY conint   CDATA "&#8750;" ><!--CONTOUR INTEGRAL -->
<!ENTITY cup      SDATA "[cup   ]" ><!--UNION -->
<!ENTITY Dot      SDATA "[Dot   ]" ><!--DIAERESIS -->
<!ENTITY DotDot   SDATA "[DotDot]" ><!--COMBINING FOUR DOTS ABOVE -->
<!ENTITY equiv    SDATA "[equiv ]" ><!--IDENTICAL TO -->
<!ENTITY exist    SDATA "[exist ]" ><!--THERE EXISTS -->
<!ENTITY fnof     CDATA "&#402;" ><!--LATIN SMALL LETTER F WITH HOOK -->
<!ENTITY forall   SDATA "[forall]" ><!--FOR ALL -->
<!ENTITY ge       SDATA "[ge    ]" ><!--GREATER-THAN OR EQUAL TO -->
<!ENTITY hamilt   CDATA "&#8459;" ><!--SCRIPT CAPITAL H -->
<!ENTITY iff      CDATA "&#8660;" ><!--LEFT RIGHT DOUBLE ARROW -->
<!ENTITY infin    SDATA "[infin ]" ><!--INFINITY -->
<!ENTITY int      SDATA "[int   ]" ><!--INTEGRAL -->
<!ENTITY isin     SDATA "[isin  ]" ><!--ELEMENT OF -->
<!ENTITY lagran   CDATA "&#8466;" ><!--SCRIPT CAPITAL L -->
<!ENTITY lang     SDATA "[lang  ]" ><!--LEFT-POINTING ANGLE BRACKET -->
<!ENTITY lArr     SDATA "[lArr  ]" ><!--LEFTWARDS DOUBLE ARROW -->
<!ENTITY le       SDATA "[le    ]" ><!--LESS-THAN OR EQUAL TO -->
<!ENTITY lowast   CDATA "&#8727;" ><!--ASTERISK OPERATOR -->
<!ENTITY minus    SDATA "[minus ]" ><!--MINUS SIGN -->
<!ENTITY mnplus   SDATA "[mnplus]" ><!--MINUS-OR-PLUS SIGN -->
<!ENTITY nabla    SDATA "[nabla ]" ><!--NABLA -->
<!ENTITY ne       SDATA "[ne    ]" ><!--NOT EQUAL TO -->
<!ENTITY ni       SDATA "[ni    ]" ><!--CONTAINS AS MEMBER -->
<!ENTITY notin    SDATA "[notin ]" ><!--NOT AN ELEMENT OF -->
<!ENTITY or       SDATA "[or    ]" ><!--LOGICAL OR -->
<!ENTITY order    CDATA "&#8500;" ><!--SCRIPT SMALL O -->
<!ENTITY par      SDATA "[par   ]" ><!--PARALLEL TO -->
<!ENTITY part     SDATA "[part  ]" ><!--PARTIAL DIFFERENTIAL -->
<!ENTITY permil   CDATA "&#8240;" ><!--PER MILLE SIGN -->
<!ENTITY perp     SDATA "[perp  ]" ><!--UP TACK -->
<!ENTITY phmmat   CDATA "&#8499;" ><!--SCRIPT CAPITAL M -->
<!ENTITY Prime    SDATA "[Prime ]" ><!--DOUBLE PRIME -->
<!ENTITY prime    SDATA "[prime ]" ><!--PRIME -->
<!ENTITY prop     SDATA "[prop  ]" ><!--PROPORTIONAL TO -->
<!ENTITY radic    SDATA "[radic ]" ><!--SQUARE ROOT -->
<!ENTITY rang     SDATA "[rang  ]" ><!--RIGHT-POINTING ANGLE BRACKET -->
<!ENTITY rArr     SDATA "[rArr  ]" ><!--RIGHTWARDS DOUBLE ARROW -->
<!ENTITY sim      SDATA "[sim   ]" ><!--TILDE OPERATOR -->
<!ENTITY sime     SDATA "[sime  ]" ><!--ASYMPTOTICALLY EQUAL TO -->
<!ENTITY square   CDATA "&#9633;" ><!--WHITE SQUARE -->
<!ENTITY sub      SDATA "[sub   ]" ><!--SUBSET OF -->
<!ENTITY sube     SDATA "[sube  ]" ><!--SUBSET OF OR EQUAL TO -->
<!ENTITY sup      SDATA "[sup   ]" ><!--SUPERSET OF -->
<!ENTITY supe     SDATA "[supe  ]" ><!--SUPERSET OF OR EQUAL TO -->
<!ENTITY tdot     CDATA "&#8411;" ><!--COMBINING THREE DOTS ABOVE -->
<!ENTITY there4   SDATA "[there4]" ><!--THEREFORE -->
<!ENTITY tprime   SDATA "[tprime]" ><!--TRIPLE PRIME -->
<!ENTITY Verbar   SDATA "[Verbar]" ><!--DOUBLE VERTICAL LINE -->
<!ENTITY wedgeq   CDATA "&#8793;" ><!--ESTIMATES -->
