<!--
     Character entity set. Typical invocation:
     <!ENTITY % isogrk3 PUBLIC
       "ISO 8879-1986//ENTITIES Added Latin 1//EN">
     %isogrk3;
-->

<!ENTITY alpha    SDATA "[alpha ]" ><!--GREEK SMALL LETTER ALPHA -->
<!ENTITY beta     SDATA "[beta  ]" ><!--GREEK SMALL LETTER BETA -->
<!ENTITY chi      SDATA "[chi   ]" ><!--GREEK SMALL LETTER CHI -->
<!ENTITY Delta    SDATA "[Delta ]" ><!--GREEK CAPITAL LETTER DELTA -->
<!ENTITY delta    SDATA "[delta ]" ><!--GREEK SMALL LETTER DELTA -->
<!ENTITY epsi     CDATA "&#1013;" ><!--GREEK LUNATE EPSILON SYMBOL -->
<!ENTITY epsis    CDATA "&#1013;" ><!--GREEK LUNATE EPSILON SYMBOL -->
<!ENTITY epsiv    SDATA "[epsiv ]" ><!--GREEK SMALL LETTER EPSILON -->
<!ENTITY eta      SDATA "[eta   ]" ><!--GREEK SMALL LETTER ETA -->
<!ENTITY Gamma    SDATA "[Gamma ]" ><!--GREEK CAPITAL LETTER GAMMA -->
<!ENTITY gamma    SDATA "[gamma ]" ><!--GREEK SMALL LETTER GAMMA -->
<!ENTITY gammad   CDATA "&#989;" ><!--GREEK SMALL LETTER DIGAMMA -->
<!ENTITY iota     SDATA "[iota  ]" ><!--GREEK SMALL LETTER IOTA -->
<!ENTITY kappa    SDATA "[kappa ]" ><!--GREEK SMALL LETTER KAPPA -->
<!ENTITY kappav   CDATA "&#1008;" ><!--GREEK KAPPA SYMBOL -->
<!ENTITY Lambda   SDATA "[Lambda]" ><!--GREEK CAPITAL LETTER LAMDA -->
<!ENTITY lambda   SDATA "[lambda]" ><!--GREEK SMALL LETTER LAMDA -->
<!ENTITY mu       SDATA "[mu    ]" ><!--GREEK SMALL LETTER MU -->
<!ENTITY nu       SDATA "[nu    ]" ><!--GREEK SMALL LETTER NU -->
<!ENTITY Omega    SDATA "[Omega ]" ><!--GREEK CAPITAL LETTER OMEGA -->
<!ENTITY omega    SDATA "[omega ]" ><!--GREEK SMALL LETTER OMEGA -->
<!ENTITY Phi      SDATA "[Phi   ]" ><!--GREEK CAPITAL LETTER PHI -->
<!ENTITY phis     SDATA "[phis  ]" ><!--GREEK PHI SYMBOL -->
<!ENTITY phiv     CDATA "&#966;" ><!--GREEK SMALL LETTER PHI -->
<!ENTITY Pi       SDATA "[Pi    ]" ><!--GREEK CAPITAL LETTER PI -->
<!ENTITY pi       SDATA "[pi    ]" ><!--GREEK SMALL LETTER PI -->
<!ENTITY piv      SDATA "[piv   ]" ><!--GREEK PI SYMBOL -->
<!ENTITY Psi      SDATA "[Psi   ]" ><!--GREEK CAPITAL LETTER PSI -->
<!ENTITY psi      SDATA "[psi   ]" ><!--GREEK SMALL LETTER PSI -->
<!ENTITY rho      SDATA "[rho   ]" ><!--GREEK SMALL LETTER RHO -->
<!ENTITY rhov     CDATA "&#1009;" ><!--GREEK RHO SYMBOL -->
<!ENTITY Sigma    SDATA "[Sigma ]" ><!--GREEK CAPITAL LETTER SIGMA -->
<!ENTITY sigma    SDATA "[sigma ]" ><!--GREEK SMALL LETTER SIGMA -->
<!ENTITY sigmav   CDATA "&#962;" ><!--GREEK SMALL LETTER FINAL SIGMA -->
<!ENTITY tau      SDATA "[tau   ]" ><!--GREEK SMALL LETTER TAU -->
<!ENTITY Theta    SDATA "[Theta ]" ><!--GREEK CAPITAL LETTER THETA -->
<!ENTITY thetas   SDATA "[thetas]" ><!--GREEK SMALL LETTER THETA -->
<!ENTITY thetav   SDATA "[thetav]" ><!--GREEK THETA SYMBOL -->
<!ENTITY Upsi     SDATA "[Upsi  ]" ><!--GREEK UPSILON WITH HOOK SYMBOL -->
<!ENTITY upsi     SDATA "[upsi  ]" ><!--GREEK SMALL LETTER UPSILON -->
<!ENTITY Xi       SDATA "[Xi    ]" ><!--GREEK CAPITAL LETTER XI -->
<!ENTITY xi       SDATA "[xi    ]" ><!--GREEK SMALL LETTER XI -->
<!ENTITY zeta     SDATA "[zeta  ]" ><!--GREEK SMALL LETTER ZETA -->
