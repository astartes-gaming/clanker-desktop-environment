#!/bin/sh
#####################################################################
##  dtmodernapp ROLE [ARGS...] - run the Xfce or KDE application for
##  ROLE, or CDE's own.
##
##  Settings > Session > "Applications" writes "xfce" or "kde" to
##  ~/.dt/modern-apps (an empty file, from older versions, is Xfce)
##  and points the Text Editor, Terminal and Home Folder actions here.
##  The chosen desktop's application is used when it is installed;
##  otherwise the original CDE action runs, so removing an application,
##  or choosing CDE's own, falls back by itself.  The Xfce applications
##  get the CDE colors (the "CDE" GTK theme that Settings > Color
##  writes); Konsole gets them through dtterminal.  Plain POSIX sh.
##
##  ROLE     Xfce / others          KDE                   CDE fallback
##  editor   mousepad               kate, kwrite          Dtpad action
##  term     xfce4-terminal         konsole               Dtterm action
##  files    thunar                 dolphin               DtfileHome / Dtfile
##  mail     thunderbird, evolution, kmail, thunderbird  dtmail
##           geary, claws-mail
##  calendar orage, gnome-calendar, korganizer, merkuro  dtcm
##           evolution, thunderbird
##  calc     galculator, gnome-calculator, kcalc, kalk  dtcalc
##           mate-calc, qalculate
##  printers system-config-printer  KDE's printer page    dtprintinfo
##
##  For mail, calendar, calc and printers the CDE program runs itself
##  (their actions are the ones overridden), with the arguments given.
#####################################################################

have() { command -v "$1" >/dev/null 2>&1; }

role=$1; [ $# -gt 0 ] && shift
case $role in
    editor) cde=Dtpad ;;
    term)   cde=Dtterm ;;
    files)  cde=Dtfile
            [ $# -eq 0 ] && cde=DtfileHome ;;
    mail|calendar|calc|printers) cde= ;;
    *)      echo "usage: dtmodernapp editor|term|files|mail|calendar|calc|printers [args]" >&2
            exit 2 ;;
esac
DTBIN=`dirname "$0"`

# first installed program of the list
pick() { for x in "$@"; do have "$x" && { echo "$x"; return; }; done; }

suite=
if [ -f "$HOME/.dt/modern-apps" ]; then
    suite=`head -1 "$HOME/.dt/modern-apps" | sed 's/[^a-z].*//'`
    [ "$suite" = kde ] || suite=xfce
fi

app=
case $suite.$role in
    xfce.editor) have mousepad && app=mousepad ;;
    xfce.term)   have xfce4-terminal && app=xfce4-terminal ;;
    xfce.files)  have thunar && app=thunar ;;
    kde.editor)  if have kate; then app=kate
                 elif have kwrite; then app=kwrite; fi ;;
    kde.term)    have konsole && app=konsole ;;
    kde.files)   have dolphin && app=dolphin ;;
    kde.mail)    app=`pick kmail thunderbird evolution geary claws-mail` ;;
    *.mail)      app=`pick thunderbird evolution geary claws-mail sylpheed kmail` ;;
    kde.calendar) app=`pick korganizer merkuro-calendar thunderbird gnome-calendar` ;;
    *.calendar)  app=`pick orage gnome-calendar evolution thunderbird korganizer` ;;
    kde.calc)    app=`pick kcalc kalk qalculate-qt galculator gnome-calculator` ;;
    *.calc)      app=`pick galculator gnome-calculator mate-calc qalculate-gtk kcalc` ;;
    kde.printers) if have kcmshell6; then app=kcmshell6; set -- kcm_printer_manager
                  elif have system-config-printer; then app=system-config-printer; set --; fi ;;
    *.printers)  if have system-config-printer; then app=system-config-printer; set --
                 elif have kcmshell6; then app=kcmshell6; set -- kcm_printer_manager; fi ;;
esac
[ -z "$suite" ] && app=
# calendars inside a mail program
case $role.$app in
    calendar.thunderbird) set -- -calendar ;;
    calendar.evolution)   set -- --component=calendar ;;
esac

if [ -n "$app" ]; then
    [ "$role" = files ] && [ $# -eq 0 ] && set -- "$HOME"
    case $suite in
    xfce)
        # The CDE colors: live through XSETTINGS (dtxsettings), else a
        # fixed GTK_THEME.
        if ! dtxsettings start 2>/dev/null; then
            for t in "$HOME/.themes/CDE" "${XDG_DATA_HOME:-$HOME/.local/share}/themes/CDE"; do
                if [ -f "$t/gtk-3.0/gtk.css" ]; then
                    GTK_THEME=CDE; export GTK_THEME
                    break
                fi
            done
        fi ;;
    kde)
        # Konsole in the CDE colors, as Settings > Terminal does
        if [ "$app" = konsole ] && have dtterminal; then
            DT_TERMINAL=konsole; export DT_TERMINAL
            exec dtterminal "$@"
        fi
        # under the window manager's frame, not a Wayland compositor's
        [ -n "$DISPLAY" ] && QT_QPA_PLATFORM=xcb && export QT_QPA_PLATFORM ;;
    esac
    exec $app "$@"
fi
case $role in
    mail)     exec "$DTBIN/dtmail" "$@" ;;
    calendar) exec "$DTBIN/dtcm" "$@" ;;
    calc)     exec "$DTBIN/dtcalc" "$@" ;;
    printers) [ $# -eq 0 ] && set -- -all
              exec "$DTBIN/dtprintinfo" "$@" ;;
esac
exec dtaction $cde "$@"
