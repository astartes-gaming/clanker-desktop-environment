#!/bin/sh
#####################################################################
##  dtmodernapp ROLE [ARGS...] - run the Xfce or KDE application for
##  ROLE, or CDE's own.
##
##  Settings > Session > "Applications" writes "xfce" or "kde" to
##  ~/.dt/modern-apps (an empty file, from older versions, is Xfce)
##  and points the Text Editor, Terminal and Home Folder actions here.
##  The chosen desktop's application is used when it is installed;
##  otherwise the original CDE action runs, so removing an application,
##  or choosing CDE's own, falls back by itself.  The Xfce applications
##  get the CDE colors (the "CDE" GTK theme that Settings > Color
##  writes); Konsole gets them through dtterminal.  Plain POSIX sh.
##
##  ROLE   Xfce             KDE              CDE fallback (action)
##  editor mousepad         kate, kwrite     Dtpad
##  term   xfce4-terminal   konsole          Dtterm
##  files  thunar           dolphin          DtfileHome (no ARGS) / Dtfile
#####################################################################

have() { command -v "$1" >/dev/null 2>&1; }

role=$1; [ $# -gt 0 ] && shift
case $role in
    editor) cde=Dtpad ;;
    term)   cde=Dtterm ;;
    files)  cde=Dtfile
            [ $# -eq 0 ] && cde=DtfileHome ;;
    *)      echo "usage: dtmodernapp editor|term|files [args]" >&2
            exit 2 ;;
esac

suite=
if [ -f "$HOME/.dt/modern-apps" ]; then
    suite=`head -1 "$HOME/.dt/modern-apps" | sed 's/[^a-z].*//'`
    [ "$suite" = kde ] || suite=xfce
fi

app=
case $suite.$role in
    xfce.editor) have mousepad && app=mousepad ;;
    xfce.term)   have xfce4-terminal && app=xfce4-terminal ;;
    xfce.files)  have thunar && app=thunar ;;
    kde.editor)  if have kate; then app=kate
                 elif have kwrite; then app=kwrite; fi ;;
    kde.term)    have konsole && app=konsole ;;
    kde.files)   have dolphin && app=dolphin ;;
esac

if [ -n "$app" ]; then
    [ "$role" = files ] && [ $# -eq 0 ] && set -- "$HOME"
    case $suite in
    xfce)
        # The CDE colors: live through XSETTINGS (dtxsettings), else a
        # fixed GTK_THEME.
        if ! dtxsettings start 2>/dev/null; then
            for t in "$HOME/.themes/CDE" "${XDG_DATA_HOME:-$HOME/.local/share}/themes/CDE"; do
                if [ -f "$t/gtk-3.0/gtk.css" ]; then
                    GTK_THEME=CDE; export GTK_THEME
                    break
                fi
            done
        fi ;;
    kde)
        # Konsole in the CDE colors, as Settings > Terminal does
        if [ "$app" = konsole ] && have dtterminal; then
            DT_TERMINAL=konsole; export DT_TERMINAL
            exec dtterminal "$@"
        fi
        # under the window manager's frame, not a Wayland compositor's
        [ -n "$DISPLAY" ] && QT_QPA_PLATFORM=xcb && export QT_QPA_PLATFORM ;;
    esac
    exec $app "$@"
fi
exec dtaction $cde "$@"
