#!/bin/ksh
#####################################################################
##  File:        0070.dtmodern
##
##  Location:    CDE_DATA_TOP/config/Xsession.d/
##
##  Purpose:     Integrate CDE sessions with modern desktop plumbing:
##               freedesktop.org session variables, the D-Bus session
##               bus, systemd --user / D-Bus activation environment,
##               XDG autostart, dtstyle's GTK/Qt theming, touchpad
##               settings, locking the screen before suspend and the
##               optional compositor.
##
##  Sourced by:  CDE_INSTALLATION_TOP/bin/Xsession (after .dtprofile)
##
##  Every step is detected at runtime and skipped when the facility is
##  missing, so on older or non-Linux systems this file does nothing
##  harmful.  It uses only Bourne/ksh88 syntax.
##
##  Per-user opt-outs (set in $HOME/.dtprofile):
##      DT_NO_DBUS=1            don't start a D-Bus session bus
##      DT_NO_XDG_AUTOSTART=1   don't run ~/.config/autostart etc.
##      DT_NO_TOUCHPAD=1        don't apply Style Manager touchpad settings
##      DT_NO_TOUCH=1           no touchscreen gestures (dttouch)
##      DT_NO_LOCK_ON_SLEEP=1   don't lock the screen before suspend
##      DT_NO_COMPOSITOR=1      don't start the compositor even if enabled
##      DT_NO_SYSTEMD_SESSION=1 don't start graphical-session.target
##      DT_WINDOW_MANAGER=dtwm  use dtwm even if xfwm4 is installed
##                              (or name another window manager)
##
##  Part of the Clanker Desktop Environment (LGPL-2.0-or-later).
#####################################################################

_dtm_have() { type "$1" >/dev/null 2>&1; }

#
# 1. Identify the desktop, as freedesktop.org specs and portals expect.
#
: ${XDG_CURRENT_DESKTOP:=CDE}
: ${XDG_SESSION_DESKTOP:=CDE}
: ${DESKTOP_SESSION:=cde}
: ${XDG_SESSION_TYPE:=x11}
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION XDG_SESSION_TYPE

#
# 1b. Window manager.  xfwm4 when installed (it manages the windows;
#     dtwm still draws the Front Panel, backdrops and Workspace menu),
#     otherwise dtwm.  dtsession reads DT_WINDOW_MANAGER unless the
#     wmStartupCommand resource is set.
#
if [ -z "$DT_WINDOW_MANAGER" ]; then
  if _dtm_have xfwm4; then
    DT_WINDOW_MANAGER=xfwm4
  else
    DT_WINDOW_MANAGER=dtwm
  fi
fi
export DT_WINDOW_MANAGER

# xfwm4 in a CDE session: Motif-style frames and button layout by
# default (the user's own xfwm4 settings still win).
case $DT_WINDOW_MANAGER in
  *xfwm4)
    _dtm_xdg="${DT_BINPATH:-/usr/dt/bin}"; _dtm_xdg="${_dtm_xdg%/bin}/config/xdg"
    if [ -d "$_dtm_xdg" ]; then
      XDG_CONFIG_DIRS="$_dtm_xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
      export XDG_CONFIG_DIRS
    fi
    unset _dtm_xdg ;;
esac

#
# 2. GTK/Qt theming written by Style Manager > Color
#    ("Apply colors to GTK and Qt applications").
#
if [ -r "$HOME/.dt/theming/env" ]; then
  . "$HOME/.dt/theming/env"
elif [ -f "$HOME/.dt/modern-apps" ] &&
     [ -x "${DT_BINPATH:-/usr/dt/bin}/dtxsettings" ]; then
  "${DT_BINPATH:-/usr/dt/bin}/dtxsettings" start 2>/dev/null  # Xfce apps
fi

#
# 3. D-Bus session bus.  Prefer the per-user bus that logind/systemd
#    provides; otherwise start a private one that ends with the X session.
#
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -z "$DT_NO_DBUS" ]; then
  if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    export DBUS_SESSION_BUS_ADDRESS
  elif _dtm_have dbus-launch; then
    eval `dbus-launch --sh-syntax --exit-with-x11`
  fi
fi

#
# 4. Share the session environment with D-Bus-activated services and,
#    where present, systemd --user units (portals, notification daemons,
#    keyrings...) so they find this display and use the same theme.
#
if [ -n "$DBUS_SESSION_BUS_ADDRESS" ] &&
   _dtm_have dbus-update-activation-environment; then
  _dtm_vars="DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP"
  _dtm_vars="$_dtm_vars XDG_SESSION_TYPE DESKTOP_SESSION"
  _dtm_vars="$_dtm_vars GTK_THEME GTK2_RC_FILES GTK_OVERLAY_SCROLLING"
  _dtm_vars="$_dtm_vars QT_QPA_PLATFORMTHEME"
  # xfwm4 sessions: the CDE defaults for xfconfd (step 1b)
  [ -n "$XDG_CONFIG_DIRS" ] && _dtm_vars="$_dtm_vars XDG_CONFIG_DIRS"
  if _dtm_have systemctl && systemctl --user show-environment >/dev/null 2>&1
  then
    dbus-update-activation-environment --systemd $_dtm_vars >/dev/null 2>&1
  else
    dbus-update-activation-environment $_dtm_vars >/dev/null 2>&1
  fi
  unset _dtm_vars
fi

#
# 5. XDG autostart (~/.config/autostart, /etc/xdg/autostart), honoring
#    OnlyShowIn/NotShowIn for "CDE".  Runs in the background once the
#    window manager is up, so started applications get decorated.
#
if [ -z "$DT_NO_XDG_AUTOSTART" ]; then
  if _dtm_have dex; then
    _dtm_autostart="dex -a -e CDE"
  elif _dtm_have systemctl &&
       systemctl --user cat xdg-desktop-autostart.target >/dev/null 2>&1; then
    _dtm_autostart="systemctl --user start xdg-desktop-autostart.target"
  else
    _dtm_autostart=""
  fi
  if [ -n "$_dtm_autostart" ]; then
    (
      # Wait (max ~30s) for dtwm to announce itself on the root window.
      _dtm_n=0
      if _dtm_have xprop; then
        while [ $_dtm_n -lt 30 ] &&
              ! xprop -root _MOTIF_WM_INFO 2>/dev/null | grep window >/dev/null; do
          sleep 1; _dtm_n=`expr $_dtm_n + 1`
        done
      else
        sleep 10
      fi
      $_dtm_autostart >/dev/null 2>&1
    ) &
  fi
  unset _dtm_autostart
fi

#
# 6. Touchpad settings from Style Manager > Mouse (tap to click, natural
#    scrolling...).  dttouchpad re-applies them when a touchpad is
#    plugged in or comes back after resume, and exits with the display.
#
_dtm_bin=${DT_BINPATH:-/usr/dt/bin}
# A touchscreen: Settings > Accessibility's larger controls default to
# on (dtaccess reads DT_TOUCHSCREEN), and dttouch starts below.
if [ -z "$DT_NO_TOUCH" ] && [ -x "$_dtm_bin/dttouch" ] &&
   "$_dtm_bin/dttouch" -probe >/dev/null 2>&1; then
  DT_TOUCHSCREEN=1; export DT_TOUCHSCREEN
fi

# Settings > Accessibility: sticky/slow/bounce/mouse keys, pointer
# size, larger controls; and the on-screen keyboard at login.
if [ -x "$_dtm_bin/dtaccess" ] &&
   { [ -f "$HOME/.dt/accessibility" ] || [ -n "$DT_TOUCHSCREEN" ]; }; then
  "$_dtm_bin/dtaccess" >/dev/null 2>&1
  if "$_dtm_bin/dtaccess" -keyboard && [ -x "$_dtm_bin/dtkeyboard" ]; then
    ( sleep 8; exec "$_dtm_bin/dtkeyboard" ) >/dev/null 2>&1 &
  fi
fi

# Touchscreen gestures: long press = right click, two fingers scroll.
# dttouch -probe: only when a touchscreen is present now (DT_TOUCH=1
# starts it anyway, for one plugged in later).
if [ -z "$DT_NO_TOUCH" ] && [ -x "$_dtm_bin/dttouch" ] &&
   { [ -n "$DT_TOUCH" ] || [ -n "$DT_TOUCHSCREEN" ]; }; then
  "$_dtm_bin/dttouch" >/dev/null 2>&1 &
fi

if [ -z "$DT_NO_TOUCHPAD" ] && [ -x "$_dtm_bin/dttouchpad" ]; then
  "$_dtm_bin/dttouchpad" -watch >/dev/null 2>&1 &
fi

#
# 7. Lock the screen before suspend/hibernate and when logind asks
#    (systemd-logind or elogind only; otherwise dtsleeplock just exits).
#
if [ -z "$DT_NO_LOCK_ON_SLEEP" ] && [ -x "$_dtm_bin/dtsleeplock" ]; then
  PATH="$_dtm_bin:$PATH" "$_dtm_bin/dtsleeplock" >/dev/null 2>&1 &
fi
#
# 8. Compositor (GPU-accelerated, tear-free drawing), when turned on in
#    Style Manager > Window ($HOME/.dt/compositor) and one is installed.
#
#    xfwm4 has its own compositor.
#
if [ -z "$DT_NO_COMPOSITOR" ] && [ -f "$HOME/.dt/compositor" ] &&
   [ "$DT_WINDOW_MANAGER" = dtwm ] &&
   [ -x "$_dtm_bin/dtcompositor" ]; then
  "$_dtm_bin/dtcompositor" start >/dev/null 2>&1 &
fi
unset _dtm_bin

#
# 9. systemd --user: start graphical-session.target for this session, so
#    user services that belong to a graphical session (portals,
#    notification daemons...) start now and stop at logout (Xsession
#    stops cde-session.target).  The unit goes in the per-login runtime
#    directory, which systemd reads and logind removes at logout.
#
if [ -z "$DT_NO_SYSTEMD_SESSION" ] && [ -n "$XDG_RUNTIME_DIR" ] &&
   _dtm_have systemctl &&
   systemctl --user show-environment >/dev/null 2>&1; then
  _dtm_units="$XDG_RUNTIME_DIR/systemd/user"
  mkdir -p "$_dtm_units" 2>/dev/null
  cat > "$_dtm_units/cde-session.target" 2>/dev/null <<'_DTM_EOF'
[Unit]
Description=CDE desktop session
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
_DTM_EOF
  systemctl --user daemon-reload >/dev/null 2>&1
  systemctl --user start cde-session.target >/dev/null 2>&1 &
  unset _dtm_units
fi

unset -f _dtm_have 2>/dev/null
