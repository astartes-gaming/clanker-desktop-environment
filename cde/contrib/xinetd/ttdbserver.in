service ttdbserver
{
    disable     = yes
    type 	= RPC UNLISTED
    rpc_number	= 100083
    rpc_version	= 1
    socket_type = stream
    protocol	= tcp
    wait	= yes
    user	= root
    server	= @CDE_BINDIR@/rpc.ttdbserver
    # Local clients only.  (This used to read "127.0.0.1/0", and a /0
    # netmask matches every address.)
    only_from 	= 127.0.0.1
    bind		= 127.0.0.1
}
